<?xml version="1.0" encoding="utf-8"?>
<!-- Release / profile builds: https only, except the local dev server so a
     release build on a real phone can reach the FastAPI backend over http.
     Keep the Wi-Fi IP the same as API_BASE_URL in config/dev.json, and remove
     these dev hosts before publishing (the live backend should use https). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- Mac's Wi-Fi IP (real phone on the same Wi-Fi), one per network -->
        <domain includeSubdomains="false">10.118.236.204</domain>
        <domain includeSubdomains="false">172.31.76.197</domain>
        <!-- Android emulator -> Mac -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
